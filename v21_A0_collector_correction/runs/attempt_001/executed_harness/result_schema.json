{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A0 feasibility vector receipt, not RunOutcome",
  "type": "object",
  "required": [
    "vector_id",
    "status",
    "observed_events",
    "expectation_matched",
    "authority",
    "material_blocker"
  ],
  "properties": {
    "vector_id": {
      "type": "string",
      "pattern": "^A0-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "NOT_EXECUTED"
      ]
    },
    "observed_events": {
      "type": "array"
    },
    "expectation_matched": {
      "type": "boolean"
    },
    "authority": {
      "enum": [
        "I",
        "U",
        "X"
      ]
    },
    "material_blocker": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
